# Copia este archivo como .env.local y llena los valores reales.
# .env.local NUNCA se sube a GitHub (ya está en .gitignore).

# Panel de Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta

# Cualquier cadena larga y aleatoria — se usa para firmar la cookie de sesión.
# Generar una fácil: en una terminal, ejecuta  openssl rand -base64 32
SESSION_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# Estas dos NO son públicas: viven solo en el servidor de Vercel
# (nunca se exponen al navegador), por eso no llevan el prefijo NEXT_PUBLIC_.
